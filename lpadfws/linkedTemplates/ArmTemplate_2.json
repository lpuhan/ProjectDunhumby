{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "lpadfws"
		},
		"trigger1_properties_PL_CPYDATA_EVNT_SNOWFLAKE_parameters_FolderPath": {
			"type": "string",
			"defaultValue": "blobinput/BLOB/"
		},
		"trigger1_properties_PL_CPYDATA_EVNT_SNOWFLAKE_parameters_FileName": {
			"type": "string",
			"defaultValue": "data_0_0_0.snappy.parquet"
		},
		"trigger1_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/e814282d-cf6c-475d-b51b-37f2e04920f4/resourceGroups/MyProjectWS/providers/Microsoft.Storage/storageAccounts/msblobstorageacclp"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/trigger1')]",
			"type": "Microsoft.DataFactory/factories/triggers",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [
					"@triggerBody().folderPath",
					"@triggerBody().fileName"
				],
				"runtimeState": "Stopped",
				"pipelines": [
					{
						"pipelineReference": {
							"referenceName": "PL_CPYDATA_EVNT_SNOWFLAKE",
							"type": "PipelineReference"
						},
						"parameters": {
							"FolderPath": "[parameters('trigger1_properties_PL_CPYDATA_EVNT_SNOWFLAKE_parameters_FolderPath')]",
							"FileName": "[parameters('trigger1_properties_PL_CPYDATA_EVNT_SNOWFLAKE_parameters_FileName')]"
						}
					},
					{
						"pipelineReference": {
							"referenceName": "PL_CPYDATA_SNOWFLAKE",
							"type": "PipelineReference"
						},
						"parameters": {}
					}
				],
				"type": "BlobEventsTrigger",
				"typeProperties": {
					"blobPathBeginsWith": "/blobinput/blobs/",
					"ignoreEmptyBlobs": false,
					"scope": "[parameters('trigger1_properties_typeProperties_scope')]",
					"events": [
						"Microsoft.Storage.BlobCreated"
					]
				}
			},
			"dependsOn": []
		}
	]
}